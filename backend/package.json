{
  "name": "keleme-backend",
  "version": "1.0.0",
  "description": "\u6e34\u4e86\u4e48 AI \u996e\u6c34\u63d0\u9192 App \u540e\u7aef\u670d\u52a1",
  "type": "module",
  "scripts": {
    "db:seed": "prisma db seed",
    "db:demo-today": "tsx scripts/append-demo-today-logs.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:studio:headless": "prisma studio --browser none",
    "db:reset": "prisma migrate reset",
    "deploy:prod": "bash scripts/deploy.sh",
    "deploy:prod:pull": "bash scripts/deploy.sh --with-git-pull",
    "deploy:podman": "bash scripts/deploy-podman.sh",
    "deploy:podman:pull": "bash scripts/deploy-podman.sh --pull"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "^5.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@types/express-serve-static-core": "^5.1.3"
  }
}
