{
  "name": "keleme-backend",
  "version": "1.0.0",
  "description": "渴了么 AI 饮水提醒 App 后端服务",
  "type": "module",
  "scripts": {
    "db:seed": "prisma db seed",
    "db:demo-today": "tsx scripts/append-demo-today-logs.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:studio:headless": "prisma studio --browser none",
    "db:reset": "prisma migrate reset",
    "deploy:prod": "bash scripts/deploy.sh",
    "deploy:prod:pull": "bash scripts/deploy.sh --with-git-pull",
    "deploy:podman": "bash scripts/deploy-podman.sh",
    "deploy:podman:pull": "bash scripts/deploy-podman.sh --pull"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "pg": "^8.13.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limiter-flexible": "^5.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "@types/pg": "^8.11.10",
    "prisma": "^7.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
